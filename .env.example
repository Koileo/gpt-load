# HTTP server
# HOST controls native process listening and the default Compose host publishing
# for both the main service and provider OAuth callback ports. Keep it on
# loopback unless external access is protected.
HOST=127.0.0.1
PORT=3001
# Timeouts are seconds; the Compose stop grace period uses a duration.
GRACEFUL_SHUTDOWN_TIMEOUT=10
CONTAINER_STOP_GRACE_PERIOD=15s
READ_TIMEOUT=60
IDLE_TIMEOUT=120

# Storage
# Empty DATABASE_DSN uses ${DATA_DIR}/gpt-load.db. Otherwise set a SQLite,
# MySQL, or PostgreSQL URL; container file paths must use mounted paths.
DATA_DIR=./data
DATABASE_DSN=

# Security
# Empty values use generated auth.key and encryption.key files in DATA_DIR.
# Back up encryption.key with the database; losing it makes credentials unreadable.
AUTH_KEY=
ENCRYPTION_KEY=

# Startup proxy fallback; restart after changes.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.internal.example.com

# Optional Codex turn-state negotiation watcher; disabled by default.
# One watcher is strictly bound to one credential and one exact model. It only
# observes and injects states for that pair, and can switch that credential to
# a backup proxy while obtaining a new healthy state. Never commit a real
# authenticated proxy URL.
# TURN_STATE_WATCHER=true
# TURN_STATE_PUSH_GROUP_ID=1
# TURN_STATE_PUSH_CREDENTIAL_ID=1
# TURN_STATE_PUSH_MODELS=gpt-5.6-sol
# TURN_STATE_HEALTHY_LENGTHS=292,332
# TURN_STATE_DEGRADED_LENGTHS=312,356
# TURN_STATE_PUSH_MAX_AGE_MS=3600000
# TURN_STATE_POLL_INTERVAL=15
# TURN_STATE_DEGRADE_PROXY_MODE=custom
# TURN_STATE_DEGRADE_PROXY_URL=socks5://proxy.example.com:1080
# TURN_STATE_DIRECT_PROXY_MODE=direct
# TURN_STATE_VERIFY_INTERVAL=60
# TURN_STATE_VERIFY_TIMEOUT=120
# TURN_STATE_VERIFY_MAX_ATTEMPTS=0
# TURN_STATE_VERBOSE=false

# Logging
LOG_LEVEL=info
LOG_FORMAT=text

# Optional process override; omit to use the Models.dev setting (enabled by default).
# MODELS_DEV_AUTO_SYNC_ENABLED=true
